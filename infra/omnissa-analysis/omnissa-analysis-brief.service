[Unit]
Description=Omnissa classification (daily brief) -- restricted identity, no Gmail/token access
Wants=network-online.target
After=network-online.target
# NOT independently timer-triggered -- activated exclusively by
# omnissa-ingest-brief.service's OnSuccess=. See that unit.

[Service]
Type=oneshot
User=omnissa-analysis
Group=omnissa-analysis
ExecStart=/opt/omnissa-agent/venv/bin/python3 -m omnissa_agent.cli classify \
  --kind brief \
  --ingest-result /var/lib/omnissa-agent/drop/latest-brief.json \
  --max-age-s 1800 \
  --state-dir /var/lib/omnissa-analysis/state \
  --reports-dir /var/lib/omnissa-agent/reports \
  --report-group-readable
TimeoutStartSec=180

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/omnissa-analysis /var/lib/omnissa-agent/reports
ReadOnlyPaths=/var/lib/omnissa-agent/drop
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
