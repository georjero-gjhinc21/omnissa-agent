[Unit]
Description=Daily 07:55 America/Chicago trigger for omnissa-analysis-brief.service
# 10 minutes after omnissa-ingest-brief.timer (07:45), 5 minutes before
# the 08:00 target so the finished brief is ready on time.

[Timer]
OnCalendar=*-*-* 07:55:00
Persistent=true

[Install]
WantedBy=timers.target
