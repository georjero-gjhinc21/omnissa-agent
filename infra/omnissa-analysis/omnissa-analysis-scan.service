[Unit]
Description=Omnissa classification (hourly bounded scan) -- restricted identity, no Gmail/token access
Wants=network-online.target
After=network-online.target
# NOT independently timer-triggered -- this unit is activated exclusively
# by omnissa-ingest-scan.service's OnSuccess=, immediately after a clean
# ingest completes. No fixed time offset, no independent schedule, so
# there is no window where this could run against a stale or
# partially-written drop file. See that unit for the failure-chaining
# reasoning.

[Service]
Type=oneshot
User=omnissa-analysis
Group=omnissa-analysis
ExecStart=/opt/omnissa-agent/venv/bin/python3 -m omnissa_agent.cli classify \
  --kind scan \
  --ingest-result /var/lib/omnissa-agent/drop/latest-scan.json \
  --max-age-s 1800 \
  --state-dir /var/lib/omnissa-analysis/state \
  --reports-dir /var/lib/omnissa-agent/reports \
  --report-group-readable \
  --focus-in /var/lib/omnissa-agent/drop/focus.json \
  --baseline-file /opt/omnissa-agent/docs/omnissa-partner-baseline.md
TimeoutStartSec=180

# Hardening: this identity is never in docker/sudo/adm -- see the
# deploy script and docs/gmail-ingestion-security-review.md. It also
# never touches an OAuth token; it only reads a sanitized drop file.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
# drop is ReadWrite, not ReadOnly: classify deletes a drop file once it
# has consumed it (see cli.py classify + the ACL grant in
# deploy-root.sh) -- ProtectSystem=strict blocks ANY write here
# regardless of DAC/ACL permissions unless the path is explicitly
# listed. Confirmed live (2026-09-30) that ReadOnlyPaths here caused
# every delete to fail silently ("Read-only file system"), so consumed
# drop files were never actually removed.
ReadWritePaths=/var/lib/omnissa-analysis /var/lib/omnissa-agent/reports /var/lib/omnissa-agent/drop
# Real content only ever needs to reach the local OmniRoute gateway
# (combo-private/Ollama by default). Widening to combo-continuous is a
# conscious, separate operator decision -- and would ALSO require
# loosening this to allow real internet egress, not just a code flag.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
