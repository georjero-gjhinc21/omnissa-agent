[Unit]
Description=Omnissa Gmail ingestion (hourly bounded scan) -- privileged identity only
Wants=network-online.target
After=network-online.target
# Real success-triggered chaining, not a fixed time offset: analysis
# only ever runs immediately after THIS run's clean success. A oneshot
# service that exits nonzero -- including exit 6 (PARTIAL, deadline
# hit) -- is "failed" in systemd's own accounting by default, so
# OnSuccess= correctly does NOT fire for it. A partial/failed ingest
# therefore never produces a fresh, success-looking brief; the next
# scheduled ingest run picks up where it left off instead (unprocessed
# ids were never marked seen -- see gmail_ingest.py).
OnSuccess=omnissa-analysis-scan.service

[Service]
Type=oneshot
User=omnissa-ingest
Group=omnissa-ingest
ExecStart=/opt/omnissa-agent/venv/bin/python3 -m omnissa_agent.cli ingest \
  --client-secret /var/lib/omnissa-ingest/google/client_secret.json \
  --token /var/lib/omnissa-ingest/google/token.json \
  --out /var/lib/omnissa-agent/drop/latest-scan.json \
  --max-messages 50 --max-pages 5 --deadline 90 \
  --state-dir /var/lib/omnissa-ingest/state
TimeoutStartSec=120

# Hardening -- this identity does exactly one thing and needs almost nothing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/omnissa-ingest /var/lib/omnissa-agent/drop
