[Unit]
Description=Daily 07:45 America/Chicago trigger for omnissa-ingest-brief.service
# System timezone is already America/Chicago (verified 2026-09-29 via
# `timedatectl`) -- this local-time spec needs no explicit TZ. Fires 10
# minutes before omnissa-analysis-brief.timer (07:55) so the drop file
# is always fresh when analysis reads it, and 15 minutes before the
# 08:00 target so the finished brief is ready on time.

[Timer]
OnCalendar=*-*-* 07:45:00
Persistent=true

[Install]
WantedBy=timers.target
